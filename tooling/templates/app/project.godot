; {{title}} - made by tooling/create_app.py.
; Godot rewrites this file when the editor saves and drops comments.

config_version=5

[application]

config/version="0.1.0"
config/name="{{title}}"
run/main_scene="res://addons/factory_look/opening.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/image="res://addons/factory_look/splash.png"
boot_splash/stretch_mode=1
boot_splash/bg_color=Color(0.07058824, 0.09411765, 0.16078432, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/gd_chime/plugin.cfg")

