# Filled by tooling/install.py from dependencies.json; never edited by hand.
/apps/*/addons/gd_chime/
/apps/*/addons/factory_*/
# Fetched dependencies, keyed by commit.
/.cache/
# Godot's per-project import cache.
/apps/*/.godot/
# Exports.
/build/
__pycache__/
# A site's copy of gd-chime for the web, filled by tooling/install_site.py; never edited by hand.
/sites/*/gd_chime/
